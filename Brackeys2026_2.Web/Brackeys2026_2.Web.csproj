<Project Sdk="Microsoft.NET.Sdk.WebAssembly">
    <PropertyGroup>
        <TargetFramework>net10.0-browser</TargetFramework>
        <WasmAllowUndefinedSymbols>true</WasmAllowUndefinedSymbols>
        <WasmEmitSymbolMap>true</WasmEmitSymbolMap>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <ImplicitUsings>enable</ImplicitUsings>
        <WasmBuildNative>true</WasmBuildNative>
        <NoWarn>$(NoWarn);NU5100;CS8766</NoWarn>
        <IsPackable>false</IsPackable>
        <Nullable>enable</Nullable>
    </PropertyGroup>
    
    <PropertyGroup>
        <EmccFlags>
            $(EmccFlags)
            -sALLOW_MEMORY_GROWTH=1
        </EmccFlags>
    </PropertyGroup>
    
    <ItemGroup>
        <NativeFileReference Include=".\lib\SDL3.a" Visible="true"/>
        <NativeFileReference Include=".\lib\SDL3_image.a" Visible="true"/>
        <NativeFileReference Include=".\lib\SDL3_ttf.a" Visible="true"/>
        <NativeFileReference Include=".\lib\SDL3_mixer.a" Visible="true"/>
        <_WasmPInvokeModules Include="SDL" Visible="false"/>
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\Brackeys2026_2\Brackeys2026_2.csproj" />
    </ItemGroup>

    <ItemGroup>
      <Folder Include="lib\" />
    </ItemGroup>

</Project>
